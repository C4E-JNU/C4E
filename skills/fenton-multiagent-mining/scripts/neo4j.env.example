# Copy this file to neo4j.env and fill in your own Neo4j instance.
# neo4j.env is ignored by git and must never be committed.
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=<your-username>
NEO4J_PASSWORD=<your-password>
NEO4J_DATABASE=<your-database>

# MinerU is optional; fill in your own token in the application settings.
MINERU_TOKEN=
